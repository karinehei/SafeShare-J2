func rule_by_id(id) = {
    for r in builtin_rules() {
        if r.id == id {
            give r
        }
    }
    assert false, fmt("unknown rule id: {}", id)
}

func rule_applies(rule, path) = {
    if rule.applies == "*" or rule.applies == "" {
        give true
    }
    give regex.match(rule.applies, path)
}

func strip_quotes(s) = {
    n = len(s)
    if n >= 2 {
        a = s[0]
        b = s[n - 1]
        if a == b and (a == "\"" or a == "'") {
            give slice(s, 1, n - 1)
        }
    }
    give s
}

func looks_like_placeholder(value) = {
    v = lower(trim(value))
    if v == "" {
        give true
    }
    if v == "password" or v == "secret" or v == "changeme" or v == "placeholder" {
        give true
    }
    if v == "your_password" or v == "your_api_key" or v == "your-token" or v == "example" {
        give true
    }
    if v == "null" or v == "none" or v == "todo" or v == "apikey" or v == "token" {
        give true
    }
    if v == "true" or v == "false" or v == "undefined" or v == "redacted" or v == "dummy" {
        give true
    }
    if text.is_digit(v) {
        give true
    }
    if text.starts_with(v, "${") or text.starts_with(v, "{{") or text.starts_with(v, "<") {
        give true
    }
    give false
}

func secret_from_match(pattern, content, m) = {
    rest = slice(content, m.start, len(content))
    g = regex.groups(pattern, rest)
    if type(g) == "seq" and count(g) > 0 {
        give strip_quotes(g[count(g) - 1])
    }
    give strip_quotes(m.text)
}

func match_to_findings(rule, path, content, m) = {
    raw = secret_from_match(rule.pattern, content, m)
    if rule.min_len > 0 and len(raw) < rule.min_len {
        give []
    }
    if rule.placeholders and looks_like_placeholder(raw) {
        give []
    }
    loc = line_column_at(content, m.start)
    if rule.category == "risky_config" {
        evidence = trim(m.text)
        give [make_config_finding({
                    rule_id: rule.id,
                    severity: rule.severity,
                    file: path,
                    line: loc.line,
                    column: loc.column,
                    reason: fmt("Setting: {}\n{}", evidence, rule.description),
                    recommendation: rule.recommendation
                }, evidence)]
    }
    give [make_finding({
                rule_id: rule.id,
                severity: rule.severity,
                file: path,
                line: loc.line,
                column: loc.column,
                category: rule.category,
                message: rule.name,
                reason: rule.description,
                recommendation: rule.recommendation
            }, raw)]
}

func matches_to_findings(rule, path, content) = func(m) = match_to_findings(rule, path, content, m)

# Independent per match, then concat. regex.find_all itself stays a library call.
func run_rule(rule, path, content) = {
    if not rule_applies(rule, path) {
        give []
    }
    give flatten(regex.find_all(rule.pattern, content) >> matches_to_findings(rule, path, content))
}

func apply_rule(rule, snapshot) = run_rule(rule, snapshot.path, snapshot.content)

func rule_on_content(path, content) = func(rule) = run_rule(rule, path, content)

# Regex table vs entropy stay separate functions. analyze_snapshot binds four
# independent family calls; analyze_content_with remains the per-subset engine.
func analyze_content_with(path, content, rules) = {
    give flatten(rules >> rule_on_content(path, content))
}

# Rule families for independent pure calls (J2 montecarlo shape: sibling
# bindings, then concat). Ids follow builtin_rules() order within a family.
KNOWN_TOKEN_IDS = [
    "aws_access_key_id",
    "github_token",
    "openai_style_api_key",
    "google_api_key",
    "jwt_token"
]
PRIVATE_KEY_IDS = ["pem_private_key"]
DATABASE_CREDENTIAL_IDS = ["database_url_credentials"]
SENSITIVE_DATA_IDS = [
    "bearer_token",
    "generic_password",
    "generic_api_key",
    "generic_secret_assignment"
]
RISKY_CONFIG_IDS = [
    "debug_enabled",
    "node_env_development",
    "cors_wildcard",
    "tls_verification_disabled",
    "authentication_disabled"
]

func rule_has_id(ids) = func(rule) = contains(ids, rule.id)

func detect_rule_ids(snap, ids) = {
    give analyze_content_with(snap.path, snap.content, builtin_rules() ? rule_has_id(ids))
}

func detect_known_token_formats(snap) = detect_rule_ids(snap, KNOWN_TOKEN_IDS)

func detect_private_keys(snap) = detect_rule_ids(snap, PRIVATE_KEY_IDS)

func detect_database_credentials(snap) = detect_rule_ids(snap, DATABASE_CREDENTIAL_IDS)

# Nested fan-out: three pure calls, no shared buffer, concat after all return.
func detect_secrets(snap) = {
    known = detect_known_token_formats(snap)
    private_keys = detect_private_keys(snap)
    database = detect_database_credentials(snap)
    give known + private_keys + database
}

func detect_sensitive_data(snap) = detect_rule_ids(snap, SENSITIVE_DATA_IDS)

func detect_risky_config(snap) = detect_rule_ids(snap, RISKY_CONFIG_IDS)

func detect_entropy(snap) = detect_high_entropy(snap.path, snap.content)

# Documented J2 shape: independent pure calls in one body, then combine.
# Same four-call pattern as the language's montecarlo example. Pipe/flatten
# over the rule table is not that shape and is not claimed as auto-parallel.
func analyze_snapshot(snap) = {
    secrets = detect_secrets(snap)
    entropy = detect_entropy(snap)
    config = detect_risky_config(snap)
    sensitive = detect_sensitive_data(snap)
    give secrets + entropy + config + sensitive
}

func analyze_content(path, content) = analyze_snapshot(FileSnapshot(path: path, content: content))

func run_one(id, path, content) = analyze_content_with(path, content, [rule_by_id(id)])
