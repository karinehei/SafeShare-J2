import "finding.j2"
import "entropy.j2"

# Table-driven detectors. Structured prefixes (AKIA, ghp_, AIza, PEM) are
# specific. sk-, JWT, Bearer, and name=value rules are heuristic — the
# description says so. Adding a rule is appending a map.

# risky_config applies to dotenv / YAML / JSON / Python / JS / TS / Docker paths.
CONFIG_APPLIES = "(?i)(\\.(env|ya?ml|json|jsonc|py|js|jsx|mjs|cjs|ts|tsx|toml|ini|cfg|conf|properties)$|Dockerfile|docker-compose|\\.env)"

