# Synthetic corpus + ground truth.
#
# Every credential is a published example, a sequential dummy, or an
# alg=none JWT. None of them can authenticate anywhere. Ground truth
# stores file / line / rule_id only — never the secret bytes.
#
# Matching: a scan finding matches an expected record when relative
# file and rule_id are equal, and expected.line is 0 or equals finding.line.

GROUND_TRUTH_NAME = "SAFESHARE_GROUND_TRUTH.json"
DEFAULT_CORPUS_REPEAT = 1
MAX_CORPUS_REPEAT = 200

