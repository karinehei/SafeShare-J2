func corpus_hit(path, content, rule_id, needle) = {
    i = text.find(content, needle)
    if i == null {
        assert false, fmt("corpus needle missing in {}: {}", path, rule_id)
    }
    loc = line_column_at(content, i)
    give {file: path, line: loc.line, rule_id: rule_id}
}

func corpus_file(path, content, needles) = {
    expected := []
    for n in needles {
        expected = expected + [corpus_hit(path, content, n.rule_id, n.needle)]
    }
    give {path: path, content: content, expected: expected}
}

