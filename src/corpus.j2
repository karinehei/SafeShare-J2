func prefix_expected(prefix, expected) = {
    out := []
    for e in expected {
        out = out + [{file: join_path(prefix, e.file), line: e.line, rule_id: e.rule_id}]
    }
    give out
}

func prefix_corpus_file(prefix, f) = {
    give {
        path: join_path(prefix, f.path),
        content: f.content,
        expected: prefix_expected(prefix, f.expected)
    }
}

func expand_corpus_kit(kit, repeat) = {
    if repeat <= 1 {
        give kit
    }
    out := []
    i := 0
    repeat i < repeat {
        prefix = "r" + str(i)
        for f in kit {
            out = out + [prefix_corpus_file(prefix, f)]
        }
        i += 1
    }
    give out
}

func kit_expected(files) = {
    out := []
    for f in files {
        out = out + f.expected
    }
    give out
}

func kit_clean_files(files) = {
    out := []
    for f in files {
        if count(f.expected) == 0 {
            out = out + [f.path]
        }
    }
    give out
}

func ground_truth_document(files) = {
    expected = kit_expected(files)
    give {
        version: "0.1.0",
        kind: "safeshare-ground-truth",
        disclaimer: "All credentials in this corpus are synthetic and unusable. Ground truth never stores secret bytes.",
        matching: "A finding matches when file and rule_id are equal and expected.line is 0 or equals finding.line.",
        files: count(files),
        expected_count: count(expected),
        expected: expected,
        clean_files: kit_clean_files(files)
    }
}

func finding_matches_expected(f, e) = {
    if normalize_rel(f.file) != normalize_rel(e.file) {
        give false
    }
    if f.rule_id != e.rule_id {
        give false
    }
    if e.line == 0 {
        give true
    }
    give f.line == e.line
}

func first_unused_match(e, findings, matched) = {
    j := 0
    repeat j < count(findings) {
        if not contains(matched, j) and finding_matches_expected(findings[j], e) {
            give j
        }
        j += 1
    }
    give -1
}

func compact_hit(file, line, rule_id) = {
    give {file: file, line: line, rule_id: rule_id}
}

func hit_cmp(a, b) = {
    if a.file != b.file {
        if a.file < b.file {
            give -1
        }
        give 1
    }
    if a.rule_id != b.rule_id {
        if a.rule_id < b.rule_id {
            give -1
        }
        give 1
    }
    give a.line - b.line
}

func sort_hits(hits) = sort_by(hits, hit_cmp)

func prf(tp, fp, fn) = {
    prec := 0.0
    rec := 0.0
    if tp + fp == 0 {
        if fn == 0 {
            prec = 1.0
        }
    } else {
        prec = tp / (tp + fp)
    }
    if tp + fn == 0 {
        rec = 1.0
    } else {
        rec = tp / (tp + fn)
    }
    f1 := 0.0
    if prec + rec > 0.0 {
        f1 = (2.0 * prec * rec) / (prec + rec)
    }
    give {precision: prec, recall: rec, f1: f1}
}

func count_rule_id(rows, rule_id) = {
    n := 0
    for r in rows {
        if r.rule_id == rule_id {
            n += 1
        }
    }
    give n
}

func detector_ids() = {
    ids := []
    for r in builtin_rules() {
        ids = ids + [r.id]
    }
    ids = ids + ["high_entropy_string"]
    give sort(ids)
}

func per_rule_row(rule_id, expected, findings, fn_list, fp_list) = {
    exp = count_rule_id(expected, rule_id)
    det = count_rule_id(findings, rule_id)
    fn = count_rule_id(fn_list, rule_id)
    fp = count_rule_id(fp_list, rule_id)
    tp = exp - fn
    m = prf(tp, fp, fn)
    give {
        rule_id: rule_id,
        expected: exp,
        detected: det,
        true_positives: tp,
        false_positives: fp,
        false_negatives: fn,
        precision: m.precision,
        recall: m.recall,
        f1: m.f1
    }
}

func per_rule_stats(expected, findings, fn_list, fp_list) = {
    rows := []
    for id in detector_ids() {
        rows = rows + [per_rule_row(id, expected, findings, fn_list, fp_list)]
    }
    give rows
}

# Pure. expected and findings need .file, .line, .rule_id.
# Matching order does not change TP/FP/FN when records are unique.
func score_against_truth(expected, findings) = {
    ordered_expected = sort_hits(expected)
    matched := []
    fn_list := []
    for e in ordered_expected {
        j = first_unused_match(e, findings, matched)
        if j < 0 {
            fn_list = fn_list + [compact_hit(e.file, e.line, e.rule_id)]
        } else {
            matched = matched + [j]
        }
    }
    fp_list := []
    j := 0
    repeat j < count(findings) {
        if not contains(matched, j) {
            f = findings[j]
            fp_list = fp_list + [compact_hit(f.file, f.line, f.rule_id)]
        }
        j += 1
    }
    fn_sorted = sort_hits(fn_list)
    fp_sorted = sort_hits(fp_list)
    tp = count(matched)
    fp = count(fp_sorted)
    fn = count(fn_sorted)
    m = prf(tp, fp, fn)
    rules = per_rule_stats(ordered_expected, findings, fn_sorted, fp_sorted)
    give {
        true_positives: tp,
        false_positives: fp,
        false_negatives: fn,
        precision: m.precision,
        recall: m.recall,
        f1: m.f1,
        unmatched_expected: fn_sorted,
        unmatched_findings: fp_sorted,
        rules: rules
    }
}

func format_ratio(x) = {
    scaled = round(x * 1000)
    whole = floor(scaled / 1000)
    frac = scaled - whole * 1000
    if frac < 0 {
        frac = 0 - frac
    }
    fs = str(frac)
    if frac < 10 {
        fs = "00" + fs
    } else if frac < 100 {
        fs = "0" + fs
    }
    give str(whole) + "." + fs
}

func pad_rule_id(s) = {
    if len(s) >= 28 {
        give s
    }
    give s + text.repeat(" ", 28 - len(s))
}

func format_rule_row(row) = {
    give pad_rule_id(row.rule_id) +
        text.pad_left(str(row.expected), 5) +
        text.pad_left(str(row.true_positives), 5) +
        text.pad_left(str(row.false_positives), 5) +
        text.pad_left(str(row.false_negatives), 5) +
        text.pad_left(format_ratio(row.precision), 8) +
        text.pad_left(format_ratio(row.recall), 8) +
        text.pad_left(format_ratio(row.f1), 8)
}

func format_evaluate_report(corpus, result, scored) = {
    lines := [
        "SafeShare evaluate",
        "",
        fmt("Corpus:          {}", corpus),
        fmt("Files scanned:   {}", result.files_scanned),
        fmt("Expected:        {}", scored.true_positives + scored.false_negatives),
        fmt("Findings:        {}", result.findings_count),
        "",
        fmt("True positives:  {}", scored.true_positives),
        fmt("False positives: {}", scored.false_positives),
        fmt("False negatives: {}", scored.false_negatives),
        fmt("Precision:       {}", format_ratio(scored.precision)),
        fmt("Recall:          {}", format_ratio(scored.recall)),
        fmt("F1:              {}", format_ratio(scored.f1)),
        "",
        "Per-rule  (exp / tp / fp / fn / P / R / F1)",
        pad_rule_id("rule") + text.pad_left("exp", 5) + text.pad_left("tp", 5) + text.pad_left("fp", 5) + text.pad_left("fn", 5) + text.pad_left("P", 8) + text.pad_left("R", 8) + text.pad_left("F1", 8)
    ]
    for row in scored.rules {
        lines = lines + [format_rule_row(row)]
    }
    lines = lines + [
        "",
        "Placeholders, hashes, UUIDs, and prose are labeled as clean.",
        "False positives on those files would mean the scanner is matching noise."
    ]
    if count(scored.unmatched_findings) > 0 {
        lines = lines + ["", "Unmatched findings (FP):"]
        for h in scored.unmatched_findings {
            lines = lines + [fmt("  {}  {}:{}", h.rule_id, h.file, h.line)]
        }
    }
    if count(scored.unmatched_expected) > 0 {
        lines = lines + ["", "Missing expected (FN):"]
        for h in scored.unmatched_expected {
            lines = lines + [fmt("  {}  {}:{}", h.rule_id, h.file, h.line)]
        }
    }
    give join(lines, "\n")
}

func evaluate_document(corpus, result, scored) = {
    give {
        version: "0.1.0",
        kind: "safeshare-evaluate",
        corpus: corpus,
        files_scanned: result.files_scanned,
        findings: result.findings_count,
        expected: scored.true_positives + scored.false_negatives,
        true_positives: scored.true_positives,
        false_positives: scored.false_positives,
        false_negatives: scored.false_negatives,
        precision: scored.precision,
        recall: scored.recall,
        f1: scored.f1,
        rules: scored.rules,
        unmatched_expected: scored.unmatched_expected,
        unmatched_findings: scored.unmatched_findings
    }
}

func write_one_corpus_file(dest, f) = {
    outp = safe_dest_join(dest, f.path)
    if outp == "" {
        print("generate-corpus: refused unsafe path")
        proc.exit(2)
    }
    d = dirname(outp)
    if d != "" and d != "." {
        fs.mkdir_p(d)
    }
    fs.write_file(outp, f.content)
}

func generate_corpus(dest) = {
    if not dest_path_is_safe(dest) {
        print("generate-corpus: choose a folder such as ./benchmark-corpus")
        proc.exit(2)
    }
    argv = program_args(proc.argv())
    repeat_n = clamp_int(parse_positive_int_flag(argv, "--repeat", DEFAULT_CORPUS_REPEAT), 1, MAX_CORPUS_REPEAT)
    files = expand_corpus_kit(corpus_kit(), repeat_n)
    try {
        fs.mkdir_p(dest)
    } else RuntimeError {
        print("cannot create corpus directory")
        proc.exit(2)
    }
    try {
        for f in files {
            write_one_corpus_file(dest, f)
        }
        truth = ground_truth_document(files)
        report_path = join_path(dest, GROUND_TRUTH_NAME)
        if not path_is_inside(dest, report_path) {
            print("generate-corpus: refused to write ground truth outside dest")
            proc.exit(2)
        }
        fs.write_file(report_path, json.stringify_pretty(truth))
    } else RuntimeError {
        print("could not write corpus files")
        proc.exit(2)
    }
    print("SafeShare generate-corpus")
    print(fmt("Wrote {} files under {}", count(files), dest))
    print(fmt("Expected findings: {}", count(kit_expected(files))))
    print(fmt("Ground truth: {}", GROUND_TRUTH_NAME))
    print("All embedded credentials are synthetic and unusable.")
}

func load_ground_truth(root) = {
    path = join_path(root, GROUND_TRUTH_NAME)
    try {
        if not fs.is_file(path) {
            print(fmt("missing {}", GROUND_TRUTH_NAME))
            proc.exit(2)
        }
        doc = json.parse(fs.read_file(path))
        give doc
    } else RuntimeError {
        print("cannot read ground truth")
        proc.exit(2)
    }
}

func evaluate_corpus(root, max_bytes, extra_excludes, json_out) = {
    try {
        if not fs.exists(root) {
            print(fmt("path not found: {}", root))
            proc.exit(2)
        }
    } else RuntimeError {
        print("cannot access corpus path")
        proc.exit(2)
    }
    truth = load_ground_truth(root)
    expected := []
    for e in truth.expected {
        expected = expected + [{file: e.file, line: floor(e.line), rule_id: e.rule_id}]
    }
    loaded = load_tree(root, max_bytes, extra_excludes)
    result = complete_scan(loaded)
    scored = score_against_truth(expected, result.findings)
    doc = evaluate_document(root, result, scored)
    print(format_evaluate_report(root, result, scored))
    print("")
    print(json.stringify_pretty(doc))
    if json_out != "" {
        try {
            fs.write_file(json_out, json.stringify_pretty(doc))
            print("")
            print(fmt("Wrote {}", json_out))
        } else RuntimeError {
            print("could not write evaluate JSON")
            proc.exit(2)
        }
    }
}
