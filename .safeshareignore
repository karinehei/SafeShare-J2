# Known synthetic fixtures. Used by `scan .` (including CI self-scan).
# These patterns skip intentional dummy credentials; they do not weaken detectors.
#
# Ignore language: trailing / = directory, leading / = scan-root only,
# one * per segment, bare name = that file or folder at any depth.
# Not supported: **, !, character classes.

# Two-minute live demo (published AWS example + unsigned JWT).
demo-project/

# Unit/regression programs embed the same published examples as literals.
tests/
tests/fixtures/

# Generated corpus trees (local or CI). Ground-truth JSON is also built-in-skipped.
benchmark/generated/
benchmark-corpus/
corpus-out/

# Synthetic kit constants (FAKE_AWS, dummy PEM, etc.). Product code stays scanned.
src/corpus.j2

# Pages explorer fixtures only. Rooted so a folder named examples elsewhere
# stays scanned. Frontend sources under web/src stay scanned.
/examples/

# Generated bundle embeds those fixture sources for the static viewer.
# Narrower than ignoring web/: product TypeScript stays in the self-scan.
/web/public/demo-data/

# npm integrity digests in the lockfile are sha512 base64, which the entropy
# heuristic can flag. This is the lockfile only. web/src stays scanned.
/web/package-lock.json
