func finding_named(hits, rule_id) = {
    for h in hits {
        if h.rule_id == rule_id {
            give h
        }
    }
    assert false, fmt("expected finding {}", rule_id)
}

func count_named(hits, rule_id) = {
    n := 0
    for h in hits {
        if h.rule_id == rule_id {
            n += 1
        }
    }
    give n
}

func fingerprint_key(hits) = {
    parts := []
    for h in sort_findings(hits) {
        parts = parts + [h.fingerprint]
    }
    give join(parts, ",")
}

func order_key(hits) = {
    parts := []
    for h in sort_findings(hits) {
        parts = parts + [fmt("{}:{}:{}", h.rule_id, h.file, h.line)]
    }
    give join(parts, "|")
}

func report_json_of(path, content) = {
    snap = FileSnapshot(path: path, content: content)
    hits = analyze_snapshot(snap)
    give scan_report_json({
            files_discovered: 1,
            files_scanned: 1,
            files_skipped: 0,
            bytes_scanned: len(content),
            findings_count: count(hits),
            findings: hits,
            paths: [path]
    })
}

func expect_loc(content, needle, hit) = {
    i = text.find(content, needle)
    loc = line_column_at(content, i)
    assert_eq(hit.line, loc.line)
    assert_eq(hit.column, loc.column)
    give true
}

# --- known token detection ---
known_src = "AWS_ACCESS_KEY_ID=" + AWS + "\nGITHUB_TOKEN=" + GH + "\n"
known_snap = FileSnapshot(path: "tokens.env", content: known_src)
known = detect_known_token_formats(known_snap)
assert_eq(count(known), 2)
assert_eq(count_named(known, "aws_access_key_id"), 1)
assert_eq(count_named(known, "github_token"), 1)
assert_eq(count(detect_private_keys(known_snap)), 0)
assert_eq(count(detect_database_credentials(known_snap)), 0)
assert_eq(count(detect_entropy(known_snap)), 0)
assert_eq(count(detect_risky_config(known_snap)), 0)
assert_eq(count(detect_sensitive_data(known_snap)), 0)
assert_eq(count(analyze_snapshot(known_snap)), 2)

aws_hit = finding_named(known, "aws_access_key_id")
assert_eq(aws_hit.severity.name, "critical")
assert_eq(aws_hit.category, "secret")
assert_eq(aws_hit.file, "tokens.env")
assert_eq(aws_hit.fingerprint, finding_fingerprint("aws_access_key_id", AWS))
assert_eq(aws_hit.masked_value, mask_secret(AWS))
assert_eq(contains(aws_hit.masked_value, AWS), false)
expect_loc(known_src, "AKIA", aws_hit)

gh_hit = finding_named(known, "github_token")
assert_eq(gh_hit.severity.name, "critical")
assert_eq(gh_hit.category, "secret")
assert_eq(gh_hit.file, "tokens.env")
assert_eq(gh_hit.fingerprint, finding_fingerprint("github_token", GH))
assert_eq(gh_hit.masked_value, mask_secret(GH))
expect_loc(known_src, "ghp_", gh_hit)

# Same secret + rule → stable fingerprint across files.
