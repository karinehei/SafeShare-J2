# --- dedup: first-hit-wins, sequential on purpose ---
spec_a = {
    rule_id: "generic_password",
    severity: Severity::high(),
    file: "first.env",
    line: 1,
    column: 1,
    category: "credential",
    message: "Hard-coded password",
    reason: "test",
    recommendation: "remove"
}
spec_b = {
    rule_id: "generic_password",
    severity: Severity::high(),
    file: "second.env",
    line: 99,
    column: 4,
    category: "credential",
    message: "Hard-coded password",
    reason: "later",
    recommendation: "remove"
}
spec_c = {
    rule_id: "generic_password",
    severity: Severity::high(),
    file: "third.env",
    line: 2,
    column: 1,
    category: "credential",
    message: "Hard-coded password",
    reason: "other",
    recommendation: "remove"
}
dup_a = make_finding(spec_a, PW)
dup_b = make_finding(spec_b, PW)
dup_c = make_finding(spec_c, "other_secret_xx")
assert_eq(dup_a.fingerprint, dup_b.fingerprint)
assert_eq(dup_a.fingerprint == dup_c.fingerprint, false)

uniq = unique_findings_by_fingerprint([dup_a, dup_b, dup_c])
assert_eq(count(uniq), 2)
assert_eq(uniq[0].file, "first.env")
assert_eq(uniq[0].line, 1)
assert_eq(uniq[1].file, "third.env")

uniq_rev = unique_findings_by_fingerprint([dup_b, dup_a, dup_c])
assert_eq(count(uniq_rev), 2)
assert_eq(uniq_rev[0].file, "second.env")
assert_eq(uniq_rev[0].line, 99)

assert_eq(count(unique_findings_by_fingerprint([])), 0)
assert_eq(count(unique_findings_by_fingerprint([dup_c])), 1)

print("family_regression_test ok")
