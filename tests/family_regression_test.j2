# --- cross-family: one file, four sibling families, each once ---
mixed_src = "AWS_ACCESS_KEY_ID=" + AWS + "\nDEBUG=true\npassword = " + PW + "\nservice_blob = \"" + TOKEN + "\"\n"
mixed_snap = FileSnapshot(path: ".env", content: mixed_src)
mixed_known = detect_known_token_formats(mixed_snap)
mixed_ent = detect_entropy(mixed_snap)
mixed_cfg = detect_risky_config(mixed_snap)
mixed_sens = detect_sensitive_data(mixed_snap)
assert_eq(count(mixed_known), 1)
assert_eq(mixed_known[0].rule_id, "aws_access_key_id")
assert_eq(count(mixed_ent), 1)
assert_eq(mixed_ent[0].rule_id, "high_entropy_string")
assert_eq(count(mixed_cfg), 1)
assert_eq(mixed_cfg[0].rule_id, "debug_enabled")
assert_eq(count(mixed_sens), 1)
assert_eq(mixed_sens[0].rule_id, "generic_password")
assert_eq(count(detect_private_keys(mixed_snap)), 0)
assert_eq(count(detect_database_credentials(mixed_snap)), 0)

mixed = analyze_snapshot(mixed_snap)
assert_eq(count(mixed), 4)
assert_eq(count_named(mixed, "aws_access_key_id"), 1)
assert_eq(count_named(mixed, "high_entropy_string"), 1)
assert_eq(count_named(mixed, "debug_enabled"), 1)
assert_eq(count_named(mixed, "generic_password"), 1)
assert_eq(count(unique_findings_by_fingerprint(mixed)), 4)
assert_eq(count(detect_secrets(mixed_snap) + mixed_ent + mixed_cfg + mixed_sens), 4)

mixed_aws = finding_named(mixed, "aws_access_key_id")
assert_eq(mixed_aws.file, ".env")
assert_eq(mixed_aws.severity.name, "critical")
expect_loc(mixed_src, "AKIA", mixed_aws)
expect_loc(mixed_src, "DEBUG=true", finding_named(mixed, "debug_enabled"))
expect_loc(mixed_src, "password", finding_named(mixed, "generic_password"))
expect_loc(mixed_src, "service_blob", finding_named(mixed, "high_entropy_string"))

# --- determinism: repeat pure analysis ---
mixed2 = analyze_snapshot(mixed_snap)
mixed3 = analyze_snapshot(mixed_snap)
assert_eq(count(mixed), count(mixed2))
assert_eq(count(mixed2), count(mixed3))
assert_eq(fingerprint_key(mixed), fingerprint_key(mixed2))
assert_eq(fingerprint_key(mixed2), fingerprint_key(mixed3))
assert_eq(order_key(mixed), order_key(mixed2))
assert_eq(order_key(mixed2), order_key(mixed3))

r1 = score_findings(mixed)
r2 = score_findings(mixed2)
r3 = score_findings(mixed3)
assert_eq(r1.score, r2.score)
assert_eq(r2.score, r3.score)
assert_eq(r1.label, r2.label)

j1 = report_json_of(".env", mixed_src)
j2 = report_json_of(".env", mixed_src)
assert_eq(j1, j2)
assert_eq(contains(j1, AWS), false)
assert_eq(contains(j1, PW), false)
assert_eq(contains(j1, TOKEN), false)
parsed = json.parse(j1)
assert_eq(parsed.summary.findings, 4)
assert_eq(parsed.summary.risk_score, r1.score)
assert_eq(parsed.summary.safe_to_share, false)
assert_eq(parsed.findings[0].rule_id, "aws_access_key_id")
assert_eq(order_key(mixed), "aws_access_key_id:.env:1|generic_password:.env:3|high_entropy_string:.env:4|debug_enabled:.env:2")

ai1 = ai_share_assessment_text(mixed)
