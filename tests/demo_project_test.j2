import "rules.j2"

# Locks the two-minute demo-project/ scan story.
# Same strings as the fixture files; keep them in sync.

env = "# SafeShare demo — INTENTIONALLY FAKE and unusable.\n# The access key id is the published AWS documentation example.\n# It cannot sign requests and must not be used outside this fixture.\nAWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE\nS3_BUCKET=safeshare-demo-example\nDATABASE_URL=postgres://127.0.0.1:5432/safeshare_demo\n"

config = "// SafeShare demo — INTENTIONALLY FAKE local config.\n// Wildcard CORS and disabled TLS checks are here so a scan has something\n// besides credentials to talk about. Do not copy this into production.\n\nexport const config = {\n  CORS: \"*\",\n  rejectUnauthorized: false,\n}\n"

app = "import { config } from \"./config.ts\"\n\n// SafeShare demo — INTENTIONALLY FAKE session.\n// Unsigned alg=none JWT. It authenticates nowhere. Do not send it\n// to a real API or paste it into an assistant chat as a live token.\nconst demoSession = \"eyJhbGciOiJub25lIn0.eyJmb28iOiJiYXIifQ.signaturexx\"\n\nexport function handler() {\n  return {\n    cors: config.CORS,\n    session: demoSession,\n    note: \"synthetic demo user — not a real account\",\n  }\n}\n"

compose = "# SafeShare demo — local-only compose.\n# DEBUG is on so the scan can show a LOW config finding.\n# No credentials live in this file.\n\nservices:\n  web:\n    image: node:20-alpine\n    working_dir: /app\n    environment:\n      DEBUG: \"true\"\n      PORT: \"3000\"\n      DATABASE_URL: \"postgres://127.0.0.1:5432/safeshare_demo\"\n"

agents = "# Agent notes (SafeShare demo)\n\nThis tree is a **two-minute SafeShare fixture**, not a product.\n\n- Every credential-shaped string is **synthetic and unusable**.\n- Do not paste `.env` or `src/app.ts` into ChatGPT, Claude, Gemini, Cursor, or Copilot as if they were a real app.\n"

readme = "# SafeShare demo project\n\nAll credentials are synthetic and unusable. See the table in demo-project/README.md.\n"

env_hits = analyze_content(".env", env)
assert_eq(count(env_hits), 1)
assert_eq(env_hits[0].rule_id, "aws_access_key_id")
assert_eq(env_hits[0].severity.name, "critical")
assert_eq(contains(env_hits[0].to_text(), "AKIAIOSFODNN7EXAMPLE"), false)

app_hits = analyze_content("src/app.ts", app)
assert_eq(count(app_hits), 1)
assert_eq(app_hits[0].rule_id, "jwt_token")
assert_eq(app_hits[0].severity.name, "high")
assert_eq(contains(app_hits[0].to_text(), "eyJhbGciOiJub25lIn0"), false)

cfg_hits = analyze_content("src/config.ts", config)
assert_eq(count(cfg_hits), 2)
cfg_ids = [cfg_hits[0].rule_id, cfg_hits[1].rule_id]
assert_eq(contains(cfg_ids, "tls_verification_disabled"), true)
assert_eq(contains(cfg_ids, "cors_wildcard"), true)

compose_hits = analyze_content("docker-compose.yml", compose)
assert_eq(count(compose_hits), 1)
assert_eq(compose_hits[0].rule_id, "debug_enabled")
assert_eq(compose_hits[0].severity.name, "low")

assert_eq(count(analyze_content("AGENTS.md", agents)), 0)
assert_eq(count(analyze_content("README.md", readme)), 0)

all = env_hits + app_hits + cfg_hits + compose_hits
assert_eq(count(all), 5)
n_crit := 0
n_high := 0
n_med := 0
n_low := 0
for f in all {
    if f.severity.name == "critical" { n_crit += 1 }
    if f.severity.name == "high" { n_high += 1 }
    if f.severity.name == "medium" { n_med += 1 }
    if f.severity.name == "low" { n_low += 1 }
}
assert_eq(n_crit, 1)
assert_eq(n_high, 2)
assert_eq(n_med, 1)
assert_eq(n_low, 1)

print("demo_project_test ok")
